{
  "rewrites": [
    {
      "source": "/:prefix(scl|sh|s)/:rest*",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|Discordbot|WhatsApp|TelegramBot|LinkedInBot|SkypeUriPreview|Applebot|Pinterestbot|redditbot|Embedly|Iframely|Mastodon|Google-InspectionTool).*" }],
      "destination": "/api/share?prefix=:prefix&rest=:rest*"
    },
    {
      "source": "/",
      "has": [
        { "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|Discordbot|WhatsApp|TelegramBot|LinkedInBot|SkypeUriPreview|Applebot|Pinterestbot|redditbot|Embedly|Iframely|Mastodon|Google-InspectionTool).*" },
        { "type": "query", "key": "url" }
      ],
      "destination": "/api/share"
    },
    { "source": "/((?!api/|assets/|favicon\\.svg|og\\.png).*)", "destination": "/index.html" }
  ]
}
