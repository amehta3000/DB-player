# Browser sign-in ("Connect Dropbox"). Public value — safe to ship in the bundle.
VITE_DROPBOX_APP_KEY=

# Optional guest mode: listeners can play shared folders without signing in.
# Server-side only (Vercel env vars). Never prefix these with VITE_.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
